{
  "format": "dds-layout",
  "version": 1,
  "name": "Shift hand-off",
  "description": "Notes sections for the outgoing shift, plus the production snapshot.",
  "panels": [
    {
      "id": "hand",
      "title": "Shift hand-off",
      "icon": "🔁",
      "span": 12
    }
  ],
  "order": [
    "cpanel-hand",
    "panel-production",
    "panel-highlights",
    "panel-safety",
    "panel-quality",
    "panel-sanitation",
    "panel-costs",
    "panel-hr",
    "panel-sap",
    "panel-warehouse",
    "panel-inventory"
  ],
  "spans": {
    "panel-safety": 4,
    "panel-quality": 8,
    "panel-production": 12,
    "panel-sanitation": 4,
    "panel-costs": 4,
    "panel-hr": 4,
    "panel-sap": 4,
    "panel-warehouse": 4,
    "panel-inventory": 4,
    "panel-highlights": 12,
    "cpanel-hand": 12
  },
  "hidden": [
    "panel:panel-costs",
    "panel:panel-hr",
    "panel:panel-inventory",
    "panel:panel-quality",
    "panel:panel-safety",
    "panel:panel-sanitation",
    "panel:panel-sap",
    "panel:panel-warehouse"
  ],
  "cw": [
    {
      "id": "w12",
      "panel_id": "cpanel-hand",
      "widget_type": "text",
      "sheet": "(text)",
      "field": "(text)",
      "agg": null,
      "range_days": 0,
      "target": null,
      "target_dir": "gte",
      "full_width": false,
      "label": "What went well",
      "body": "Wins from this shift. Edit this note."
    },
    {
      "id": "w13",
      "panel_id": "cpanel-hand",
      "widget_type": "text",
      "sheet": "(text)",
      "field": "(text)",
      "agg": null,
      "range_days": 0,
      "target": null,
      "target_dir": "gte",
      "full_width": false,
      "label": "What needs attention",
      "body": "Open problems the next shift should know about."
    },
    {
      "id": "w14",
      "panel_id": "cpanel-hand",
      "widget_type": "text",
      "sheet": "(text)",
      "field": "(text)",
      "agg": null,
      "range_days": 0,
      "target": null,
      "target_dir": "gte",
      "full_width": false,
      "label": "Equipment and maintenance",
      "body": "Anything down, being repaired, or waiting on parts."
    },
    {
      "id": "w15",
      "panel_id": "cpanel-hand",
      "widget_type": "text",
      "sheet": "(text)",
      "field": "(text)",
      "agg": null,
      "range_days": 0,
      "target": null,
      "target_dir": "gte",
      "full_width": false,
      "label": "Safety and quality notes",
      "body": "Near misses, holds, sanitation items."
    }
  ],
  "src": {},
  "hl": [
    {
      "key": "Quality",
      "label": "Quality",
      "icon": "🥇"
    },
    {
      "key": "Production",
      "label": "Production",
      "icon": "⚙️"
    },
    {
      "key": "Sanitation",
      "label": "Sanitation",
      "icon": "🧼"
    },
    {
      "key": "Warehouse",
      "label": "Warehouse",
      "icon": "🏭"
    },
    {
      "key": "Maintenance",
      "label": "Maintenance",
      "icon": "⭐"
    }
  ],
  "prod": {
    "left": {
      "show": true
    },
    "right": {
      "tiles": [
        {
          "id": "code-red",
          "label": "Code Red",
          "sheet": "Maintenance",
          "field": "Code Red",
          "agg": "last",
          "format": "number",
          "date": "selected",
          "target": {
            "better": "down",
            "red": 3,
            "amber": 1
          }
        },
        {
          "id": "code-yellow",
          "label": "Code Yellow",
          "sheet": "Maintenance",
          "field": "Code Yellow",
          "agg": "last",
          "format": "number",
          "date": "selected",
          "target": {
            "better": "down",
            "red": 8,
            "amber": 4
          }
        }
      ],
      "table": {
        "show": true,
        "title": "Lines",
        "columns": [
          {
            "label": "OEE",
            "field": "OEE",
            "agg": "avg",
            "format": "percent0",
            "date": "selected",
            "target": {
              "better": "up",
              "red": 0.6,
              "amber": 0.65
            }
          },
          {
            "label": "Attainment",
            "field": "Attainment",
            "agg": "avg",
            "format": "percent1",
            "date": "latest",
            "target": {
              "better": "up",
              "red": 0.8,
              "amber": 0.9
            }
          },
          {
            "label": "DT",
            "field": "Downtime",
            "agg": "sum",
            "format": "minutes",
            "date": "selected",
            "target": {
              "better": "down",
              "red": 120,
              "amber": 60
            }
          }
        ]
      }
    },
    "totals": {
      "show": true,
      "tiles": [
        {
          "id": "pounds-planned",
          "label": "Pounds Planned",
          "sheet": "Production",
          "field": "Expected Pounds",
          "agg": "sum",
          "format": "number",
          "date": "latest"
        },
        {
          "id": "pounds-produced",
          "label": "Pounds Produced",
          "sheet": "Production",
          "field": "Actual Pounds",
          "agg": "sum",
          "format": "number",
          "date": "latest"
        }
      ]
    }
  }
}