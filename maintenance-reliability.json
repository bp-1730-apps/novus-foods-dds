{
  "format": "dds-layout",
  "version": 1,
  "name": "Maintenance and reliability",
  "description": "Code Red / Code Yellow front and centre, downtime by line, plus trend cards.",
  "panels": [
    {
      "id": "maint",
      "title": "Maintenance",
      "icon": "🔧",
      "span": 12
    }
  ],
  "order": [
    "cpanel-maint",
    "panel-production",
    "panel-highlights",
    "panel-safety",
    "panel-quality",
    "panel-sanitation",
    "panel-costs",
    "panel-hr",
    "panel-sap",
    "panel-warehouse",
    "panel-inventory"
  ],
  "spans": {
    "panel-safety": 4,
    "panel-quality": 8,
    "panel-production": 12,
    "panel-sanitation": 4,
    "panel-costs": 4,
    "panel-hr": 4,
    "panel-sap": 4,
    "panel-warehouse": 4,
    "panel-inventory": 4,
    "panel-highlights": 12,
    "cpanel-maint": 12
  },
  "hidden": [
    "panel:panel-costs",
    "panel:panel-hr",
    "panel:panel-inventory",
    "panel:panel-quality",
    "panel:panel-safety",
    "panel:panel-sanitation",
    "panel:panel-sap",
    "panel:panel-warehouse"
  ],
  "cw": [
    {
      "id": "w1",
      "panel_id": "cpanel-maint",
      "widget_type": "metric",
      "sheet": "Maintenance",
      "field": "Code Red",
      "agg": "latest",
      "range_days": 30,
      "target": 1,
      "target_dir": "lte",
      "full_width": false,
      "label": "Code Red",
      "body": null
    },
    {
      "id": "w2",
      "panel_id": "cpanel-maint",
      "widget_type": "metric",
      "sheet": "Maintenance",
      "field": "Code Yellow",
      "agg": "latest",
      "range_days": 30,
      "target": 4,
      "target_dir": "lte",
      "full_width": false,
      "label": "Code Yellow",
      "body": null
    },
    {
      "id": "w3",
      "panel_id": "cpanel-maint",
      "widget_type": "line",
      "sheet": "Maintenance",
      "field": "Code Red",
      "agg": null,
      "range_days": 30,
      "target": 1,
      "target_dir": "lte",
      "full_width": false,
      "label": "Code Red, last 30 days",
      "body": null
    },
    {
      "id": "w4",
      "panel_id": "cpanel-maint",
      "widget_type": "line",
      "sheet": "Maintenance",
      "field": "Code Yellow",
      "agg": null,
      "range_days": 30,
      "target": 4,
      "target_dir": "lte",
      "full_width": false,
      "label": "Code Yellow, last 30 days",
      "body": null
    }
  ],
  "src": {},
  "hl": [
    {
      "key": "Quality",
      "label": "Quality",
      "icon": "🥇"
    },
    {
      "key": "Production",
      "label": "Production",
      "icon": "⚙️"
    },
    {
      "key": "Sanitation",
      "label": "Sanitation",
      "icon": "🧼"
    },
    {
      "key": "Warehouse",
      "label": "Warehouse",
      "icon": "🏭"
    },
    {
      "key": "Maintenance",
      "label": "Maintenance",
      "icon": "⭐"
    }
  ],
  "prod": {
    "left": {
      "show": false
    },
    "right": {
      "tiles": [
        {
          "id": "code-red",
          "label": "Code Red",
          "sheet": "Maintenance",
          "field": "Code Red",
          "agg": "last",
          "format": "number",
          "date": "selected",
          "target": {
            "better": "down",
            "red": 3,
            "amber": 1
          }
        },
        {
          "id": "code-yellow",
          "label": "Code Yellow",
          "sheet": "Maintenance",
          "field": "Code Yellow",
          "agg": "last",
          "format": "number",
          "date": "selected",
          "target": {
            "better": "down",
            "red": 8,
            "amber": 4
          }
        }
      ],
      "table": {
        "show": true,
        "title": "Lines",
        "columns": [
          {
            "label": "OEE",
            "field": "OEE",
            "agg": "avg",
            "format": "percent0",
            "date": "selected",
            "target": {
              "better": "up",
              "red": 0.6,
              "amber": 0.65
            }
          },
          {
            "label": "DT",
            "field": "Downtime",
            "agg": "sum",
            "format": "minutes",
            "date": "selected",
            "target": {
              "better": "down",
              "red": 120,
              "amber": 60
            }
          }
        ]
      },
      "charts": [
        {
          "id": "pchart-dt",
          "title": "Downtime by line",
          "type": "bar",
          "sheet": "Production",
          "scope": "split",
          "days": 14,
          "series": [
            {
              "label": "Downtime (min)",
              "field": "Downtime",
              "agg": "sum"
            }
          ]
        }
      ]
    },
    "totals": {
      "show": false
    },
    "blocks": [
      "top",
      "charts",
      "table",
      "totals"
    ]
  }
}