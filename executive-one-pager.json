{
  "format": "dds-layout",
  "version": 1,
  "name": "Executive one-pager",
  "description": "A short summary: production at a glance, costs, people, highlights.",
  "panels": [],
  "order": [
    "panel-production",
    "panel-costs",
    "panel-hr",
    "panel-highlights",
    "panel-safety",
    "panel-quality",
    "panel-sanitation",
    "panel-sap",
    "panel-warehouse",
    "panel-inventory"
  ],
  "spans": {
    "panel-safety": 4,
    "panel-quality": 8,
    "panel-production": 12,
    "panel-sanitation": 4,
    "panel-costs": 6,
    "panel-hr": 6,
    "panel-sap": 4,
    "panel-warehouse": 4,
    "panel-inventory": 4,
    "panel-highlights": 12
  },
  "hidden": [
    "panel:panel-inventory",
    "panel:panel-quality",
    "panel:panel-safety",
    "panel:panel-sanitation",
    "panel:panel-sap",
    "panel:panel-warehouse"
  ],
  "cw": [],
  "src": {},
  "hl": [
    {
      "key": "Quality",
      "label": "Quality",
      "icon": "🥇"
    },
    {
      "key": "Production",
      "label": "Production",
      "icon": "⚙️"
    },
    {
      "key": "Sanitation",
      "label": "Sanitation",
      "icon": "🧼"
    },
    {
      "key": "Warehouse",
      "label": "Warehouse",
      "icon": "🏭"
    },
    {
      "key": "Maintenance",
      "label": "Maintenance",
      "icon": "⭐"
    }
  ],
  "prod": {
    "left": {
      "show": false
    },
    "right": {
      "title": "Yesterday",
      "tiles": [
        {
          "id": "code-red",
          "label": "Code Red",
          "sheet": "Maintenance",
          "field": "Code Red",
          "agg": "last",
          "format": "number",
          "date": "selected",
          "target": {
            "better": "down",
            "red": 3,
            "amber": 1
          }
        },
        {
          "id": "code-yellow",
          "label": "Code Yellow",
          "sheet": "Maintenance",
          "field": "Code Yellow",
          "agg": "last",
          "format": "number",
          "date": "selected",
          "target": {
            "better": "down",
            "red": 8,
            "amber": 4
          }
        }
      ],
      "drivers": {
        "show": false
      },
      "table": {
        "show": true,
        "title": "Lines",
        "columns": [
          {
            "label": "OEE",
            "field": "OEE",
            "agg": "avg",
            "format": "percent0",
            "date": "selected",
            "target": {
              "better": "up",
              "red": 0.6,
              "amber": 0.65
            }
          },
          {
            "label": "Attainment",
            "field": "Attainment",
            "agg": "avg",
            "format": "percent1",
            "date": "latest",
            "target": {
              "better": "up",
              "red": 0.8,
              "amber": 0.9
            }
          },
          {
            "label": "DT",
            "field": "Downtime",
            "agg": "sum",
            "format": "minutes",
            "date": "selected",
            "target": {
              "better": "down",
              "red": 120,
              "amber": 60
            }
          }
        ]
      },
      "charts": []
    },
    "totals": {
      "show": true,
      "tiles": [
        {
          "id": "pounds-planned",
          "label": "Pounds Planned",
          "sheet": "Production",
          "field": "Expected Pounds",
          "agg": "sum",
          "format": "number",
          "date": "latest"
        },
        {
          "id": "pounds-produced",
          "label": "Pounds Produced",
          "sheet": "Production",
          "field": "Actual Pounds",
          "agg": "sum",
          "format": "number",
          "date": "latest"
        }
      ]
    }
  }
}